# Copie este archivo a .env (cp .env.example .env) antes de levantar el proyecto.
# .env NO se versiona. Aquí solo hay valores de ejemplo: cámbielos por los suyos.

# Puerto del equipo en el que responde la aplicación (http://localhost:5228)
APP_PORT=5228

# Entorno de ASP.NET Core. En Development se habilita Swagger en /swagger
ASPNETCORE_ENVIRONMENT=Development

# Contraseña del usuario sa de SQL Server: mínimo 8 caracteres con mayúscula, minúscula, número y símbolo
DB_SA_PASSWORD=Ejemplo_Cambiar_123

# Clave de firma de los JWT (mínimo 32 caracteres)
JWT_KEY=clave-de-ejemplo-cambiar-por-una-aleatoria-de-64-caracteres-0123456789

# Primer Administrador, creado al arrancar (contraseña: mínimo 8 caracteres, con letra y número)
SEED_ADMIN_EMAIL=admin@whatareweeating.test
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=Admin12345

# API externa de clima (OpenWeatherMap). Clave gratuita en https://home.openweathermap.org/api_keys
# Con este valor de ejemplo la operación GET /recetas/sugeridas responde un rechazo controlado (503).
OPENWEATHER_API_KEY=tu-clave-de-openweathermap

# Correo saliente (solo con: docker compose --profile correo up --build)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASSWORD=contrasena-de-ejemplo
SMTP_FROM=usuario@example.com
SMTP_ENABLE_SSL=true
